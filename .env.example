# ─────────────────────────────────────────────────────────────────
# JIO HealthLab — environment template
# Copy to .env and fill in. NEVER commit .env or real secrets.
# ─────────────────────────────────────────────────────────────────

APP_NAME=JIO HealthLab
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://healthlab:healthlab@mysql:3306/jio_healthlab
MYSQL_DATABASE=jio_healthlab
MYSQL_USER=healthlab
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-local-only

# ── Authentication ───────────────────────────────────────────────
# REQUIRED in production. The backend refuses to start if this is still the
# development placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=jio-healthlab
# Short: an access token cannot be revoked once issued.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Long: refresh tokens are revocable and rotate on every use.
REFRESH_TOKEN_EXPIRE_DAYS=14
# Refresh tokens are delivered as an httpOnly, SameSite=Strict cookie scoped
# to /api/auth, so JavaScript -- including anything an XSS injects -- cannot
# read them. Disable only for a non-browser client that cannot hold cookies.
REFRESH_COOKIE_ENABLED=true
# Secure is set automatically in production. Leave unset locally: plain http
# is not a secure context, and the browser would discard the cookie.
# REFRESH_COOKIE_SECURE=true

# Consecutive failed sign-ins before an account locks, and for how long.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# Demo accounts created by `python -m app.seed`. Also refused in production.
SEED_ADMIN_EMAIL=admin@jiohealthlab.example.com
SEED_ADMIN_PASSWORD=ChangeMe!Admin123

# ── Backend HTTP ─────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173

# ── AI service ───────────────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_PORT=8001
AI_SERVICE_TIMEOUT_SECONDS=60

# ── Embeddings ───────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
# all-MiniLM-L6-v2 truncates input at 256 word pieces. Raise this only if you
# switch to a model with a larger window, and raise CHUNK_SIZE with it.
EMBEDDING_MAX_TOKENS=256

# ── Generation ───────────────────────────────────────────────────
# LLM_PROVIDER=none disables generation; retrieval keeps working.
LLM_PROVIDER=local
#
# Must be an INSTRUCTION-TUNED model. Measured on CPU in this image:
#   Qwen/Qwen2.5-1.5B           1.0 tok/s  base model - echoes the prompt,
#                                          loops, never answers. Unusable.
#   Qwen/Qwen2.5-1.5B-Instruct  1.1 tok/s  correct, ~37s per answer
#   Qwen/Qwen2.5-0.5B-Instruct  4.4 tok/s  correct, ~5s per answer  (default)
#
# The default keeps the stack usable on a laptop. Use the 1.5B instruct
# variant where more compute is available.
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LLM_DEVICE=cpu
LLM_MAX_NEW_TOKENS=256
LLM_TEMPERATURE=0.2
# Wall-clock ceiling for one generation; reported as finish_reason="timeout".
LLM_TIMEOUT_SECONDS=90
LLM_MAX_INPUT_TOKENS=2048

# ── Vector database ──────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=healthlab_knowledge
QDRANT_REPORT_COLLECTION=healthlab_reports
# Qdrant ships unauthenticated. A key is required here even locally, so the
# authenticated path is the one that gets exercised in development too.
# Generate a real one for production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
QDRANT_API_KEY=dev-only-qdrant-key

# ── Retrieval tuning ─────────────────────────────────────────────
TOP_K=5
SCORE_THRESHOLD=0.25
# Approximate tokens per chunk, deliberately just under EMBEDDING_MAX_TOKENS.
# A larger value is silently truncated by the embedding model.
CHUNK_SIZE=220
CHUNK_OVERLAP=40

# ── Model cache ──────────────────────────────────────────────────
# Model weights are NEVER baked into the image or committed to git. They are
# downloaded on first use into the `huggingface-cache` Docker volume and
# reused across rebuilds.
#
# First `docker compose up --build` downloads roughly:
#   all-MiniLM-L6-v2          ~90 MB   (embeddings, needed for any retrieval)
#   Qwen2.5-0.5B-Instruct     ~1.0 GB  (generation, optional)
#
# The ai-service container reports healthy before either is downloaded, so
# nothing blocks on the network at startup. `docker compose down` keeps the
# volume; `docker compose down -v` deletes it and the next start re-downloads.
HF_HOME=/models/huggingface

# ── Lightweight development ──────────────────────────────────────
# On a constrained machine, or in CI, set:
#   LLM_PROVIDER=none
# The service starts, /health reports the generation model as `disabled`, and
# everything except answer generation keeps working: document ingestion,
# /rag/search, report search, delay prediction and the whole reports product.
# /rag/query then returns 503 GENERATION_DISABLED, which the UI renders as
# "Answer generation is switched off in this deployment. Search still works."
#
# The same degradation happens automatically if the model cannot be loaded --
# no network, no disk, out of memory. Retrieval is never taken down with it.

# ── Frontend build ───────────────────────────────────────────────
VITE_API_BASE_URL=
