# ─────────────────────────────────────────────────────────────────
# JIO HealthLab — environment template
# Copy to .env and fill in. NEVER commit .env or real secrets.
# ─────────────────────────────────────────────────────────────────

APP_NAME=JIO HealthLab
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://healthlab:healthlab@mysql:3306/jio_healthlab
MYSQL_DATABASE=jio_healthlab
MYSQL_USER=healthlab
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-local-only

# ── Backend HTTP ─────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173

# ── AI service ───────────────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_PORT=8001
AI_SERVICE_TIMEOUT_SECONDS=60

# ── Embeddings ───────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

# ── Generation ───────────────────────────────────────────────────
# LLM_PROVIDER=none disables generation; retrieval keeps working.
LLM_PROVIDER=local
LLM_MODEL=Qwen/Qwen2.5-1.5B
LLM_DEVICE=cpu
LLM_MAX_NEW_TOKENS=320
LLM_TEMPERATURE=0.2

# ── Vector database ──────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=healthlab_knowledge
QDRANT_REPORT_COLLECTION=healthlab_reports
# QDRANT_API_KEY=only-needed-for-qdrant-cloud

# ── Retrieval tuning ─────────────────────────────────────────────
TOP_K=5
SCORE_THRESHOLD=0.25
CHUNK_SIZE=500
CHUNK_OVERLAP=75

# ── Model cache ──────────────────────────────────────────────────
HF_HOME=/models/huggingface

# ── Frontend build ───────────────────────────────────────────────
VITE_API_BASE_URL=
